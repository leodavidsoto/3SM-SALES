# ── Required ───────────────────────────────────────────────────────────────────

# Google Gemini API key — free tier at https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# Upload-Post credentials — https://uploadpost.app
UPLOAD_POST_API_KEY=your_upload_post_api_key_here
UPLOAD_POST_PROFILE=your_profile_name_here

# ── Folders ────────────────────────────────────────────────────────────────────

# Drop long-form vertical videos here (9:16, 1080×1920 recommended)
INPUT_FOLDER=~/Documents/skill-autoshorts/input

# Processed clips, transcripts, and candidates stored here
OUTPUT_FOLDER=~/Documents/skill-autoshorts/output

# ── Optional ───────────────────────────────────────────────────────────────────

# Whisper model size: tiny | base | small | medium | large-v3
# medium = best quality/speed balance. First run downloads ~1.5 GB.
WHISPER_MODEL=medium

# Your timezone for scheduling (used in logs)
TIMEZONE=Europe/Madrid
